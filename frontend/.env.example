# Browser transport
#
# Leave this blank to use the same-origin /api/parse proxy (recommended).
# Set it to a parser origin such as https://parser.example.com only when that
# deployment explicitly allows this frontend origin through CORS.
NEXT_PUBLIC_PARSE_API_URL=

# The parser may legitimately take several minutes for a large document. This
# default is slightly longer than the backend's 300-second processing timeout.
NEXT_PUBLIC_PARSE_API_TIMEOUT_MS=330000

# Client-side preflight limit in bytes. Keep this aligned with the backend's
# MAX_UPLOAD_BYTES setting. The backend remains the final authority.
NEXT_PUBLIC_PARSE_API_MAX_UPLOAD_BYTES=20971520

# Same-origin proxy transport
#
# Local development default: http://127.0.0.1:8000
# Set a different value per development, staging, or production deployment.
# A full endpoint ending in /v1/parse is also accepted.
PARSE_API_URL=http://127.0.0.1:8000
PARSE_API_TIMEOUT_MS=330000
