# Request limits
MAX_UPLOAD_BYTES=20971520
# Applies to PDF pages and image frames.
MAX_DOCUMENT_PAGES=100
# Backward-compatible fallback when MAX_DOCUMENT_PAGES is unset:
# MAX_PDF_PAGES=100
MAX_IMAGE_PIXELS=50000000
MAX_IMAGE_TOTAL_PIXELS=100000000
DOCUMENT_TIMEOUT_SECONDS=300

# Local OCR
OCR_LANGUAGES=eng
TESSERACT_CMD=tesseract
# TESSERACT_DATA_PATH=/usr/share/tesseract-ocr/5/tessdata
TARGETED_OCR_TIMEOUT_SECONDS=30
TARGETED_OCR_SCALE=5
TARGETED_OCR_MAX_PIXELS=16000000

# Shared visual-analysis quality controls for image uploads, scanned PDF pages,
# and PDF image/chart/diagram regions. Raw OCR remains in diagnostics.
IMAGE_PRIMARY_OCR_MIN_CONFIDENCE=0.45
IMAGE_LOW_CONFIDENCE_MIN_ALNUM_CHARS=8
IMAGE_HEADING_MIN_CONFIDENCE=0.75
IMAGE_HEADING_HEIGHT_RATIO=1.8
IMAGE_HEADING_MIN_PAGE_HEIGHT_RATIO=0.025
IMAGE_PICTURE_CLASSIFICATION_THRESHOLD=0.6

# Selective PDF rendering. Native text remains authoritative; rendering is
# limited to image-only pages, incomplete layout text, and uncovered visual
# regions.
PDF_VISUAL_ANALYSIS_ENABLED=true
PDF_RENDER_OCR_MIN_NATIVE_ALNUM_CHARS=24
PDF_RENDER_OCR_MIN_LAYOUT_COVERAGE=0.55

# Optional local semantic captions for visual regions in either input type.
# Disabled unless the SmolVLM snapshot is already present locally.
IMAGE_CAPTIONING_ENABLED=false
# IMAGE_CAPTIONING_PROMPT=Describe this visible image faithfully in one concise sentence.

# Pre-downloaded local Docling models
DOCLING_ARTIFACTS_PATH=.models/docling

# Optional per-process PDF/image converter prewarming. The single rollback
# switch is false by default; while false, the prewarm timeout, shutdown-grace,
# and digest controls below are ignored and the predecessor's lazy converter
# caches remain in use. Tesseract and artifact-path settings still configure
# that predecessor path.
PARSER_LATENCY_PREWARM_ENABLED=false
# IMPORTANT: true is accepted only inside the reviewed capability-bearing
# Darwin/non-root supervisor topology. Plain uvicorn, Docker/Linux, root, or a
# missing/invalid supervisor capability fails closed before readiness. The
# supervisor-only PARSER_TESSERACT_* descriptors/identities are private launch
# inputs and must not be copied into this file.
# Application identities required only in that supervised true mode:
# TESSERACT_CMD=/absolute/resolved/path/to/tesseract
# TESSERACT_DATA_PATH=/absolute/resolved/path/to/tessdata
# HF_HUB_OFFLINE=1
# TRANSFORMERS_OFFLINE=1
# PARSER_LATENCY_PREWARM_ARTIFACTS_SHA256=<64 lowercase hex characters>
# PARSER_LATENCY_PREWARM_DEPENDENCY_SHA256=<64 lowercase hex characters>
# PARSER_LATENCY_PREWARM_TIMEOUT_SECONDS=300
# PARSER_LATENCY_PREWARM_SHUTDOWN_GRACE_SECONDS=2

# Phase 1 compatibility paths. All remain off by default. Canonical
# serialization requires both preceding flags and adds the versioned
# canonical_presentation object plus canonical Markdown serialization.
PARSER_SHARED_IR_ENABLED=false
PARSER_SHARED_IR_NORMALIZATION_ENABLED=false
PARSER_CANONICAL_SERIALIZATION_ENABLED=false

# Phase 2 font-integrity audit. Detection is internal, does not rewrite text,
# and requires both shared-IR flags so findings remain typed IR concerns.
PARSER_TEXT_INTEGRITY_FONT_AUDIT_ENABLED=false
PARSER_TEXT_INTEGRITY_FONT_RECOVERY_ENABLED=false
PARSER_TEXT_INTEGRITY_SELECTIVE_SPAN_OCR_ENABLED=false
# Deterministically select among attributable native/font/OCR alternatives.
# Requires the complete shared-IR and Phase 2 evidence pipeline above.
PARSER_TEXT_RECONCILIATION_ENABLED=false
# Join only explicitly labeled, exact-length uppercase digest fragments.
# Decimal-only OCR runs and raw token evidence remain unchanged.
PARSER_OCR_NUMERIC_CLEANUP_V2_ENABLED=false
# Preserve bounded, bbox-addressable OCR token occurrences. Requires numeric
# cleanup v2; additive occurrences remain outside canonical presentation.
PARSER_OCR_SPATIAL_TOKEN_PRESERVATION_ENABLED=false
# Align layout/OCR text to unique, bounded native PDF character evidence.
# Requires the complete Phase 2 stack above.
PARSER_TEXT_INTEGRITY_SOURCE_ALIGNMENT_ENABLED=false
# Project graph- and geometry-grounded external table captions. Requires both
# shared-IR flags; default-off rollback restores the Phase 02 projection.
PARSER_LAYOUT_TABLE_CAPTIONS_ENABLED=false
# Project declared external visual captions and internal children as separate,
# geometry-validated relationships. Requires shared IR normalization.
PARSER_LAYOUT_VISUAL_RELATIONSHIPS_ENABLED=false
# Associate source-visible notes/footnotes with one unique nearby table or
# visual owner. Selective note OCR and PDF links stay bounded and fail closed.
PARSER_LAYOUT_SOURCE_NOTES_ENABLED=false
# Project source-grounded relationship bundles and finite page-space order,
# validating bbox ownership without changing boxes. Requires normalization.
PARSER_LAYOUT_RELATIONSHIP_ORDER_ENABLED=false
# Preserve sparse native-PDF font/color runs and uniquely associated
# strike/underline rules. Requires shared normalization, canonical
# serialization, and relationship order; source-visible text stays primary.
PARSER_LAYOUT_TEXT_RUN_SEMANTICS_ENABLED=false
# Extract bounded source-visible form/control and aligned key-value semantics.
# Requires shared IR, shared normalization, canonical serialization, and
# relationship order. It does not require text-run semantics.
PARSER_LAYOUT_FORMS_ENABLED=false
# Preserve bounded native-PDF bullet/decimal/lower-alpha hierarchy and one
# same-page table continuation. Requires shared IR, shared normalization,
# canonical serialization, and relationship order; default-off is exact.
PARSER_LAYOUT_OUTLINE_STRUCTURE_ENABLED=false
# Separate source-grounded running headers, footers, bounded navigation, and
# printed page identity from Body while retaining them once in Full. Requires
# shared IR, normalization, canonical serialization, and relationship order.
PARSER_LAYOUT_RUNNING_REGIONS_ENABLED=false
PARSER_TABLES_SPAN_FIDELITY_ENABLED=false
PARSER_TABLES_EVIDENCE_RECONCILIATION_ENABLED=false
PARSER_TABLES_CANDIDATE_GATE_ENABLED=false
PARSER_TABLES_MULTI_PAGE_MERGE_ENABLED=false

# Phase 05 chart/diagram schema and conservative fallback routing. All Phase 05
# behavior is additive and default-off; disabling this foundation removes the
# complete visual_structure sidecar and restores predecessor visual output.
PARSER_VISUAL_STRUCTURE_SCHEMA_ENABLED=false
# Inventory only chart-owned vector curves, rectangles, lines, and text
# anchors. Requires the Phase 05 visual schema foundation.
PARSER_CHARTS_VECTOR_INVENTORY_ENABLED=false
# Calibrate supported linear axes and associate chart labels, legends, and
# series. Requires vector inventory; unsupported axes remain unresolved.
PARSER_CHARTS_STRUCTURE_ENABLED=false
# Measure only supported vertical linear vector bars with grounded axis,
# category, series, baseline, provenance, confidence, and tolerance. Requires
# PARSER_CHARTS_STRUCTURE_ENABLED=true.
PARSER_CHARTS_VECTOR_VALUES_ENABLED=false
# Validate chart candidates and project supported values as chart-owned JSON
# and Markdown. Requires the visual schema plus shared IR, normalization, and
# canonical serialization, but intentionally has no vector-only dependency so
# the same boundary can admit later raster candidates.
PARSER_CHARTS_STRUCTURED_OUTPUT_ENABLED=false
# Recover conventional raster chart labels, linear axes, categories, legends,
# and swatches from spatial OCR and grounded pixel geometry. Requires the visual
# schema and spatial OCR; it deliberately has no vector/value dependency.
PARSER_CHARTS_RASTER_STRUCTURE_ENABLED=false
# Measure supported 2-D vertical raster bars using grounded raster structure.
# Requires raster structure and the shared structured-output validator.
PARSER_CHARTS_RASTER_BAR_VALUES_ENABLED=false
# Measure visible markers or unambiguous category intersections on supported
# simple 2-D raster line charts. Requires raster structure and validation.
PARSER_CHARTS_RASTER_LINE_VALUES_ENABLED=false
# Outer public admission and rollback boundary for all raster chart structure
# and value stages. Requires the visual schema, spatial OCR, raster structure,
# and structured output. Inner value flags are independently optional;
# disabling this umbrella exactly restores P05-US05 public behavior.
PARSER_CHARTS_RASTER_ANALYSIS_ENABLED=false
PARSER_CHARTS_RASTER_MAX_CROP_WIDTH=2048
PARSER_CHARTS_RASTER_MAX_CROP_HEIGHT=2048
PARSER_CHARTS_RASTER_MAX_TOTAL_PIXELS=4000000
PARSER_CHARTS_RASTER_MAX_WORK_UNITS=10000
PARSER_CHARTS_RASTER_TIMEOUT_SECONDS=2.0
PARSER_CHARTS_RASTER_MINIMUM_QUALITY=0.6
PARSER_CHARTS_RASTER_COORDINATE_TOLERANCE=0.5
# Recover only simple directed diagram topology with node geometry, contained
# spatial OCR labels, explicit paths/endpoints, and grounded arrow direction.
# Requires the Phase 05 visual schema and spatial OCR preservation.
PARSER_DIAGRAMS_TOPOLOGY_ENABLED=false

# Phase 06 provider-neutral visual-model contract. This foundation is
# default-off and requires the Phase 05 visual schema. It defines bounded crop,
# source-evidence, observation, provenance, confidence, and concern envelopes;
# it does not load or call a model and does not change public output.
PARSER_VISUAL_MODELS_CONTRACT_ENABLED=false
PARSER_VISUAL_MODELS_MAX_CROP_WIDTH=2048
PARSER_VISUAL_MODELS_MAX_CROP_HEIGHT=2048
PARSER_VISUAL_MODELS_MAX_CROP_PIXELS=4000000
PARSER_VISUAL_MODELS_MAX_REQUEST_BYTES=8388608
PARSER_VISUAL_MODELS_MAX_RESPONSE_BYTES=262144
PARSER_VISUAL_MODELS_MAX_OBSERVATIONS=32
# Optional offline local adapter. Both flags default off. Enabling the adapter
# still loads nothing until usage is explicitly approved and every manifest
# field below identifies a pre-provisioned, legally approved local artifact.
# The service never downloads weights. The artifact path must be absolute and
# fully resolved, and its bytes must match the lowercase SHA-256 digest.
PARSER_VISUAL_MODELS_LOCAL_ENABLED=false
PARSER_VISUAL_MODELS_LOCAL_USAGE_APPROVED=false
PARSER_VISUAL_MODELS_LOCAL_USAGE_APPROVAL_ID=
PARSER_VISUAL_MODELS_LOCAL_ARTIFACT_PATH=
PARSER_VISUAL_MODELS_LOCAL_ARTIFACT_SHA256=
PARSER_VISUAL_MODELS_LOCAL_ARTIFACT_SOURCE=
PARSER_VISUAL_MODELS_LOCAL_LICENSE_ID=
PARSER_VISUAL_MODELS_LOCAL_MODEL_NAME=
PARSER_VISUAL_MODELS_LOCAL_MODEL_VERSION=
PARSER_VISUAL_MODELS_LOCAL_ADAPTER_NAME=local-visual-model-adapter
PARSER_VISUAL_MODELS_LOCAL_ADAPTER_VERSION=1.0.0
PARSER_VISUAL_MODELS_LOCAL_PROMPT_VERSION=grounded-v1
PARSER_VISUAL_MODELS_LOCAL_HARDWARE=cpu
PARSER_VISUAL_MODELS_LOCAL_TIMEOUT_SECONDS=2.0
PARSER_VISUAL_MODELS_LOCAL_MAX_WORK_UNITS=10000
PARSER_VISUAL_MODELS_LOCAL_MAX_CONCURRENCY=1
PARSER_VISUAL_MODELS_LOCAL_MAX_MEMORY_BYTES=1073741824
PARSER_VISUAL_MODELS_LOCAL_MAX_ARTIFACT_BYTES=2147483648

# Optional hosted adapter admission. The adapter, every approval, and every
# budget default to deny. Enabling this boundary alone grants no dispatch: an
# exact vendor/model/region/data/retention/redaction plan, all four approvals,
# and positive per-request/document budgets are required. Credentials are
# transport-owned secrets and must never be placed in this configuration.
PARSER_VISUAL_MODELS_HOSTED_ENABLED=false
PARSER_VISUAL_MODELS_HOSTED_POLICY_APPROVED=false
PARSER_VISUAL_MODELS_HOSTED_DATA_APPROVED=false
PARSER_VISUAL_MODELS_HOSTED_MINIMIZATION_APPROVED=false
PARSER_VISUAL_MODELS_HOSTED_RETENTION_APPROVED=false
PARSER_VISUAL_MODELS_HOSTED_VENDOR=
PARSER_VISUAL_MODELS_HOSTED_MODEL=
PARSER_VISUAL_MODELS_HOSTED_PROCESSING_REGION=
PARSER_VISUAL_MODELS_HOSTED_DATA_CLASS=
PARSER_VISUAL_MODELS_HOSTED_RETENTION_POLICY=
# Exact values: applied or not_required.
PARSER_VISUAL_MODELS_HOSTED_REDACTION_DECISION=
PARSER_VISUAL_MODELS_HOSTED_REDACTION_CONTEXT_ID=
PARSER_VISUAL_MODELS_HOSTED_MAX_REQUESTS=0
PARSER_VISUAL_MODELS_HOSTED_MAX_REQUEST_PIXELS=0
PARSER_VISUAL_MODELS_HOSTED_MAX_DOCUMENT_PIXELS=0
PARSER_VISUAL_MODELS_HOSTED_MAX_COST_MICROUNITS=0
PARSER_VISUAL_MODELS_HOSTED_MAX_OUTPUT_TOKENS=0
PARSER_VISUAL_MODELS_HOSTED_MAX_TIMEOUT_MS=0
PARSER_VISUAL_MODELS_HOSTED_RESERVED_COST_MICROUNITS=0
PARSER_VISUAL_MODELS_HOSTED_REQUEST_MAX_OUTPUT_TOKENS=0
PARSER_VISUAL_MODELS_HOSTED_REQUEST_TIMEOUT_MS=0
# Retries remain prohibited in the release-first hosted path.
PARSER_VISUAL_MODELS_HOSTED_MAX_ATTEMPTS=1

# Deterministic routing is a separate default-off boundary and requires the
# Phase 06 contract. It considers only evidenced unresolved visual regions,
# invokes at most one available adapter, and applies these document budgets
# before dispatch. Hosted routes additionally use the deny-by-default hosted
# policy and cost reservation above.
PARSER_VISUAL_MODELS_ROUTING_ENABLED=false
# Exact values: local_first, local_only, hosted_first, or hosted_only.
PARSER_VISUAL_MODELS_ROUTING_PREFERENCE=local_first
PARSER_VISUAL_MODELS_ROUTING_MAX_REGIONS_PER_DOCUMENT=8
PARSER_VISUAL_MODELS_ROUTING_MAX_DOCUMENT_PIXELS=8000000

# Independent Phase 05 grounding is another default-off boundary and requires
# routing. Zero tolerance is the strict default; any nonzero tolerance must be
# explicitly configured and remains bounded.
PARSER_VISUAL_MODELS_GROUNDING_ENABLED=false
PARSER_VISUAL_MODELS_GROUNDING_BBOX_TOLERANCE=0

# Transactional additive merge is the final default-off Phase 06 boundary.
# Enabling it requires the contract, routing, grounding, shared IR, shared IR
# normalization, and canonical serialization. Any rejected or failed merge
# returns the unchanged Phase 05 result.
PARSER_VISUAL_MODELS_MERGE_ENABLED=false
PARSER_VISUAL_MODELS_MERGE_MAX_OBSERVATIONS=32
PARSER_VISUAL_MODELS_MERGE_MAX_ADDED_BYTES=262144

# Phase 07 cross-format adapters. All flags are rollback boundaries and default
# off. Enable dependencies in order: conformance; image parity / OOXML intake;
# native Office adapters; Office charts; bounded fallback; future gate.
PARSER_ADAPTERS_CONFORMANCE_ENABLED=false
PARSER_ADAPTERS_IMAGE_PARITY_ENABLED=false
PARSER_ADAPTERS_OOXML_INTAKE_ENABLED=false
PARSER_ADAPTERS_DOCX_NATIVE_ENABLED=false
PARSER_ADAPTERS_PPTX_NATIVE_ENABLED=false
PARSER_ADAPTERS_XLSX_NATIVE_ENABLED=false
PARSER_ADAPTERS_OFFICE_CHARTS_ENABLED=false
PARSER_ADAPTERS_OFFICE_FALLBACK_ENABLED=false
PARSER_ADAPTERS_FUTURE_CONFORMANCE_GATE_ENABLED=false
PARSER_ADAPTERS_OOXML_MAX_ENTRIES=2048
PARSER_ADAPTERS_OOXML_MAX_COMPRESSED_BYTES=26214400
PARSER_ADAPTERS_OOXML_MAX_UNCOMPRESSED_BYTES=104857600
PARSER_ADAPTERS_OOXML_MAX_PART_BYTES=26214400
PARSER_ADAPTERS_OOXML_MAX_XML_NODES=250000
PARSER_ADAPTERS_OOXML_MAX_XML_DEPTH=64
PARSER_ADAPTERS_OOXML_MAX_RELATIONSHIPS=10000
PARSER_ADAPTERS_OOXML_TIMEOUT_SECONDS=5
PARSER_ADAPTERS_XLSX_MAX_SHEETS=256
PARSER_ADAPTERS_XLSX_MAX_CELLS=100000
PARSER_ADAPTERS_XLSX_MAX_ROWS=1048576
PARSER_ADAPTERS_XLSX_MAX_COLUMNS=16384
PARSER_ADAPTERS_OFFICE_FALLBACK_MAX_REGIONS=16
PARSER_ADAPTERS_OFFICE_FALLBACK_MAX_WIDTH=2048
PARSER_ADAPTERS_OFFICE_FALLBACK_MAX_HEIGHT=2048
PARSER_ADAPTERS_OFFICE_FALLBACK_MAX_TOTAL_PIXELS=8000000
PARSER_ADAPTERS_OFFICE_FALLBACK_MAX_RENDERER_BYTES=33554432
PARSER_ADAPTERS_OFFICE_FALLBACK_TIMEOUT_SECONDS=5

# Phase 08 shipping controls. These operational behaviors remain default off.
# The global kill switch disables every registered optional shipping flag; the
# capability list accepts only registry-owned bounded names (for example
# telemetry, confidence, review, visual_models, visual, tables, adapters, or
# adapters_office_fallback) and cascades to dependent flags.
PARSER_TELEMETRY_ENABLED=false
# Auxiliary telemetry bounds are read only while the parent flag is enabled.
PARSER_TELEMETRY_QUEUE_SIZE=128
PARSER_TELEMETRY_EXPORTER_TIMEOUT_MS=50
PARSER_TELEMETRY_MAX_EVENT_BYTES=4096
PARSER_TELEMETRY_MAX_LABELS=8
PARSER_TELEMETRY_MAX_CARDINALITY_PER_LABEL=16
PARSER_TELEMETRY_RESOURCES_ENABLED=false
PARSER_TELEMETRY_QUALITY_ENABLED=false
PARSER_CONFIDENCE_DETERMINISTIC_CALIBRATION_ENABLED=false
PARSER_CONFIDENCE_VISUAL_CALIBRATION_ENABLED=false
PARSER_REVIEW_ESCALATION_ENABLED=false
PARSER_SHIPPING_KILL_SWITCH=false
PARSER_SHIPPING_DISABLED_CAPABILITIES=

# Optional Phase 08 release-artifact startup gate. With both values unset the
# gate is a no-op and preserves the default local-core startup. Setting either
# manifest control requires both; an invalid digest, profile, candidate root,
# or artifact blocks startup. Set ROOT to the exact candidate filesystem
# boundary (it otherwise defaults to the service working directory).
# PARSER_RELEASE_ARTIFACT_MANIFEST_PATH=/absolute/path/to/release-manifest.json
# PARSER_RELEASE_ARTIFACT_MANIFEST_SHA256=<64 lowercase hex characters>
# PARSER_RELEASE_ARTIFACT_ROOT=/absolute/candidate/root
# Production is the only release profile. `local_reference` is reserved for
# verifying the checked-in Darwin developer evidence and must not be deployed.
# PARSER_RELEASE_ARTIFACT_PROFILE=production
