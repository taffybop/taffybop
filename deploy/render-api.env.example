# Non-secret Render Docker web-service configuration.
# See docs/deployment-render.md. Import these values on the API service only.
# Initial trial limits; resource capacity has not been established by a load test.
MAX_UPLOAD_BYTES=20971520
PARSER_MAX_REQUEST_BODY_BYTES=22020096
PARSER_MAX_CONCURRENT_PARSE_REQUESTS=1
PARSER_UPLOAD_TIMEOUT_SECONDS=60
MAX_DOCUMENT_PAGES=20
MAX_IMAGE_PIXELS=20000000
MAX_IMAGE_TOTAL_PIXELS=40000000
DOCUMENT_TIMEOUT_SECONDS=180
PARSER_CORS_ALLOWED_ORIGINS=https://taffybop.io,https://www.taffybop.io

# Docker downloads the models at image build time; runtime remains offline.
DOCLING_ARTIFACTS_PATH=/opt/docling-models
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
TOKENIZERS_PARALLELISM=false
TESSERACT_CMD=tesseract
PARSER_LATENCY_PREWARM_ENABLED=false

# The 33 enabled parser features match start-ui-backend-8042.sh.
PARSER_SHARED_IR_ENABLED=true
PARSER_SHARED_IR_NORMALIZATION_ENABLED=true
PARSER_CANONICAL_SERIALIZATION_ENABLED=true
PARSER_TEXT_INTEGRITY_FONT_AUDIT_ENABLED=true
PARSER_TEXT_INTEGRITY_FONT_RECOVERY_ENABLED=true
PARSER_TEXT_INTEGRITY_SELECTIVE_SPAN_OCR_ENABLED=true
PARSER_TEXT_RECONCILIATION_ENABLED=true
PARSER_OCR_NUMERIC_CLEANUP_V2_ENABLED=true
PARSER_OCR_SPATIAL_TOKEN_PRESERVATION_ENABLED=true
PARSER_TEXT_INTEGRITY_SOURCE_ALIGNMENT_ENABLED=true
PARSER_LAYOUT_TABLE_CAPTIONS_ENABLED=true
PARSER_LAYOUT_VISUAL_RELATIONSHIPS_ENABLED=true
PARSER_LAYOUT_SOURCE_NOTES_ENABLED=true
PARSER_LAYOUT_RELATIONSHIP_ORDER_ENABLED=true
PARSER_LAYOUT_TEXT_RUN_SEMANTICS_ENABLED=true
PARSER_LAYOUT_FORMS_ENABLED=true
PARSER_LAYOUT_OUTLINE_STRUCTURE_ENABLED=true
PARSER_LAYOUT_RUNNING_REGIONS_ENABLED=true
PARSER_TABLES_SPAN_FIDELITY_ENABLED=true
PARSER_TABLES_EVIDENCE_RECONCILIATION_ENABLED=true
PARSER_TABLES_CANDIDATE_GATE_ENABLED=true
PARSER_TABLES_MULTI_PAGE_MERGE_ENABLED=true
PARSER_VISUAL_STRUCTURE_SCHEMA_ENABLED=true
PARSER_CHARTS_VECTOR_INVENTORY_ENABLED=true
PARSER_CHARTS_STRUCTURE_ENABLED=true
PARSER_CHARTS_VECTOR_VALUES_ENABLED=true
PARSER_CHARTS_STRUCTURED_OUTPUT_ENABLED=true
PARSER_CHARTS_RASTER_STRUCTURE_ENABLED=true
PARSER_CHARTS_RASTER_BAR_VALUES_ENABLED=true
PARSER_CHARTS_RASTER_LINE_VALUES_ENABLED=true
PARSER_CHARTS_RASTER_ANALYSIS_ENABLED=true
PARSER_DIAGRAMS_TOPOLOGY_ENABLED=true
PARSER_CHARTS_SOURCE_ASSET_ENABLED=true

# Keep Docker's release manifest, digest, artifact-root, and UI-path defaults.
# Let Render supply PORT; retain the Docker CMD (python -m app.release_start).
# Do not set a public frontend API URL here: it belongs to the static build.
